# Copy to ~/.config/quicknote/env and chmod 600.
# This file is gitignored — never commit real values.

# Internal integration secret from notion.so/profile/integrations
NOTION_TOKEN="ntn_REPLACE_ME"

# 32-char ID from your database URL:
# https://notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DB="REPLACE_ME"

# Optional: journal database ID (same URL format). Notes starting with "j"
# are appended to that day's page here instead of the quick notes database.
NOTION_JOURNAL_DB="REPLACE_ME"
